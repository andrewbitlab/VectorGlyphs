# VectorGlyphs environment template
# Copy to .env for local development. Never commit .env.

# Public app URL
NEXT_PUBLIC_APP_URL=https://vectorglyphs.com

# Database
DATABASE_URL=postgresql://vectorglyphs:vectorglyphs_dev_password@postgres:5432/vectorglyphs
POSTGRES_DB=vectorglyphs
POSTGRES_USER=vectorglyphs
POSTGRES_PASSWORD=change-me

# Stripe test keys only during development. Live keys are intentionally rejected by the local Phase 4 backend.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_EXPORT_PACK=price_test_replace_me

# Telegram feedback forwarding; optional until configured
TELEGRAM_BOT_TOKEN=
TELEGRAM_FEEDBACK_CHAT_ID=

# Download token signing/derivation secret
DOWNLOAD_TOKEN_SECRET=replace-with-long-random-secret-at-least-32-chars

# Storage
VECTORGLYPHS_STORAGE_ROOT=/data/vector-glyphs

# API/networking
API_INTERNAL_URL=http://api:8000
CORS_ALLOWED_ORIGINS=https://vectorglyphs.com

# Cloudflare Tunnel; configure only after approval
CLOUDFLARE_TUNNEL_TOKEN=
